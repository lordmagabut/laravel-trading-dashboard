# Laravel API Base URL (from OpenClaw VM perspective)
LARAVEL_API_BASE_URL=http://127.0.0.1:8000/api

# Number of pending analyses to fetch per run
PENDING_LIMIT=1

# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=30

# OpenClaw timeout in seconds
OPENCLAW_TIMEOUT_SECONDS=900

# Dry run mode (set to true to skip actual API calls)
# DRY_RUN=false